GROQ_API_KEY=your_groq_key
ELEVENLABS_API_KEY=your_elevenlabs_key
# elevenlabs | browser  (browser = free Web Speech fallback, handy while developing)
TTS_PROVIDER=elevenlabs
# hard cap on characters sent to ElevenLabs from this server (credit guard)
TTS_CHAR_BUDGET=2000
LLM_MODEL=openai/gpt-oss-120b
STT_MODEL=whisper-large-v3
